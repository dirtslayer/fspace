Coord);         gl_FragColor = abgr;         gl_FragColor.r = abgr.b;         gl_FragColor.b = abgr.r;         gl_FragColor *= u_color;     } ␀␀␀␀0‹␀␀ÿÿÿÿk␀␀ÀO␀     precision mediump float;     uniform sampler2D u_texture;     uniform vec4 u_color;     varying vec2 v_texCoord;         void main()     {         vec4 abgr = texture2D(u_texture, v_texCoord);         gl_FragColor = abgr;         gl_FragColor.r = abgr.b;         gl_FragColor.b = abgr.r;         gl_FragColor.a = 1.0;         gl_FragColor *= u_color;     } ␀␀0‹␀␀ÿÿÿÿ)␀␀@Q␀␀␀␀␀     precision mediump float;     uniform sampler2D u_texture;     uniform vec4 u_color;     varying vec2 v_texCoord;         void main()     {         vec4 abgr = texture2D(u_texture, v_texCoord);         gl_FragColor = abgr;         gl_FragColor.a = 1.0;         gl_FragColor *= u_color;     } ␀␀␀␀0‹␀␀ÿÿÿÿ'␀␀€R␀␀␀␀␀precision mediump float;
uniform sampler2D u_texture;
uniform sampler2D u_texture_u;
uniform sampler2D u_texture_v;
uniform vec4 u_color;
varying vec2 v_texCoord;

// YUV offset 
const vec3 offset = vec3(0, -0.501960814, -0.501960814);

// RGB coefficients 
const mat3 matrix = mat3( 1,       1,        1,
                          0,      -0.3441,   1.772,
                          1.402,  -0.7141,   0);

void main()
{
    mediump vec3 yuv;
    lowp vec3 rgb;

    // Get the YUV values 
