    -- Octave 3 (lower)
    C3   = 130.81,
    Cs3  = 138.59,  Db3 = 138.59,
    D3   = 146.83,
    Ds3  = 155.56,  Eb3 = 155.56,
    E3   = 164.81,
    F3   = 174.61,
    Fs3  = 185.00,  Gb3 = 185.00,
    G3   = 196.00,
    Gs3  = 207.65,  Ab3 = 207.65,
    A3   = 220.00,
    As3  = 233.08,  Bb3 = 233.08,
    B3   = 246.94,

    -- Octave 5 (higher)
    C5   = 523.25,
    Cs5  = 554.37,  Db5 = 554.37,
    D5   = 587.33,
    Ds5  = 622.25,  Eb5 = 622.25,
    E5   = 659.25,
    F5   = 698.46,
    Fs5  = 739.99,  Gb5 = 739.99,
    G5   = 783.99,
