local text = {
            
    
    Char.new(10, 10, 0, 'f'),
    Char.new(30, 10, 0, 's'),
    Char.new(50, 10, 0, 'p'),
    Char.new(70, 10, 0, 'a'),
    Char.new(90, 10, 0, 'c'),
    Char.new(110, 10, 0, 'e'),

    Char.new(30, 70, 0, 'p'),
